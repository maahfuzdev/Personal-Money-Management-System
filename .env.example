# Copy this file to .env for a local Docker Compose run. Replace all values.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DB_USERNAME=money_manager_app
DB_PASSWORD=replace-with-a-local-app-password
JWT_SECRET=replace-with-output-from-openssl-rand-base64-32
JWT_ISSUER=personal-money-manager
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8081/api/v1
